{
  "name": "create-crate",
  "version": "0.0.1",
  "description": "Create a new crate CLI application",
  "keywords": [
    "cli",
    "crate",
    "create",
    "generator",
    "scaffold",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "create-crate": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@clack/prompts": "^0.10.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
